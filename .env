# ================================
# FRONTEND ENVIRONMENT VARIABLES
# ================================

# API Configuration
# Production: requests go to https://alphakolect.com (nginx proxies to Express on port 5000)
# For local development, override with: NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=https://alphakolect.com

# ================================
# NOTES
# ================================
# 1. All NEXT_PUBLIC_* variables are exposed to the browser
# 2. NEXT_PUBLIC_API_URL must NOT include a port in production — nginx proxies all
#    backend routes (/merchant, /agents, /wallet, etc.) to the Express backend on port 5000
# 3. Rebuild and restart Next.js after changing this file (npm run build)
